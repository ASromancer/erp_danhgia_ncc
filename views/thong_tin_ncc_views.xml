<odoo>
    <data>

        <record id="view_thong_tin_ncc_tree" model="ir.ui.view">
            <field name="name">thong_tin_ncc.tree</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree string="Thông Tin Nhà Cung Cấp">
                    <field name="name" string="Tên nhà cung cấp"/>
                    <field name="email" string="Email"/>
                    <field name="phone" string="Điện thoại"/>
                    <field name="danh_gia_cuoi_cung" string="Đánh giá cuối cùng"/>
                    <field name="danh_gia_moi" string="Đánh giá mới"/>
                </tree>
            </field>
        </record>

        <record id="view_thong_tin_ncc_form" model="ir.ui.view">
            <field name="name">thong_tin_ncc.form</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Thông Tin Nhà Cung Cấp">
                    <sheet>
                        <group>
                            <field name="name" required="1" string="Tên nhà cung cấp"/>
                            <field name="email" string="Email"/>
                            <field name="phone" string="Điện thoại"/>
                        </group>
                        <group>
                            <field name="danh_gia_cuoi_cung" string="Đánh giá cuối cùng"/>
                            <field name="danh_gia_moi" string="Đánh giá mới"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_thong_tin_ncc" model="ir.actions.act_window">
            <field name="name">Thông Tin NCC</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_thong_tin_ncc_tree"/>
        </record>
    </data>
</odoo>
